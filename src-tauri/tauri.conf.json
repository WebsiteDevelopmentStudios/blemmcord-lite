{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blemmcord Lite",
  "version": "0.1.0",
  "identifier": "com.websitedevelopmentstudios.blemmcordlite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blemmcord Lite",
        "url": "https://discord.com/app",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "SocialNetworking",
    "shortDescription": "A lightweight Discord desktop shell",
    "longDescription": "Blemmcord Lite is a Rust-powered Windows desktop application for the official Discord web client."
  }
}
